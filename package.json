{
  "name": "@fhlnet/color-apple",
  "version": "0.2.1",
  "description": "Apple iOS system color CSS variables with light, dark, and high-contrast themes.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "keywords": [
    "apple",
    "ios",
    "color",
    "theme",
    "css-variables",
    "dark-mode",
    "high-contrast"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --emptyOutDir",
    "build:lib": "vite build --config ./vite.config.lib.js && copy src\\index.d.ts dist\\index.d.ts",
    "preview": "vite preview demo",
    "test": "vitest"
  },
  "author": "snowray712000",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "jsdom": "^29.1.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.5"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./css": "./dist/apple-color-ios.css",
    "./apple-color-ios.css": "./dist/apple-color-ios.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowray712000/fhlnet-color-apple.git"
  },
  "homepage": "https://github.com/snowray712000/fhlnet-color-apple#readme",
  "bugs": {
    "url": "https://github.com/snowray712000/fhlnet-color-apple/issues"
  },
  "files": [
    "dist"
  ]
}